{
  "manifest_version": 3,
  "name": "Reed Job Filter",
  "version": "2.1.0",
  "description": "Filter Reed.co.uk jobs by title and recruiter.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.reed.co.uk/*"
  ],
  "action": {
    "default_title": "Reed Job Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.reed.co.uk/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}